; DSH-RL — 2D 横板动作 Roguelike（内嵌 AI 导演层）
; 设计文档：docs/横板动作Roguelike_机制拆解_v0.1.md
;           docs/横板动作Roguelike_地图生成方案_v0.1.md

config_version=5

[application]
config/name="DSH-RL"
config/description="2D 横板动作 Roguelike · 世界线确定性 + 内嵌小模型导演层"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"

